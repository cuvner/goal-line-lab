# Reference server on port 8081 for students to test against while they build their own on 8080.
# Install: sudo cp goal-line-reference.service /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable --now goal-line-reference
[Unit]
Description=Goal-line Lab reference server (port 8081)
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/goal-line-lab/server/solution
ExecStart=/usr/bin/python3 -u /home/pi/goal-line-lab/server/solution/server.py --http 8081
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
